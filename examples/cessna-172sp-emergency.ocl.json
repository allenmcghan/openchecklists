  "sections": [
    {
      "id": "engine-failure-before-rotation",
      "phase": "engine_failure_before_rotation",
      "criticality": "emergency",
      "title": "Engine Failure on Takeoff Roll (Before Lift-Off)",
      "items": [
        {
          "type": "action",
          "text": "Throttle",
          "response": "CLOSE IMMEDIATELY",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-1"
        },
        {
          "type": "action",
          "text": "Brakes",
          "response": "APPLY FIRMLY \u2014 STOP ON REMAINING RUNWAY",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-2"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-3"
        },
        {
          "type": "action",
          "text": "Ignition",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-4"
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-5"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-6"
        }
      ]
    },
    {
      "id": "engine-failure-after-takeoff",
      "phase": "engine_failure_after_takeoff",
      "criticality": "emergency",
      "title": "Engine Failure After Liftoff",
      "items": [
        {
          "type": "action",
          "text": "Best glide airspeed \u2014 pitch immediately",
          "response": "ESTABLISH PER POH",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-1"
        },
        {
          "type": "action",
          "text": "Landing area \u2014 land straight ahead or with minimal turn onto best available surface",
          "response": "SELECTED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-2"
        },
        {
          "type": "action",
          "text": "Throttle",
          "response": "CLOSE",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-3"
        },
        {
          "type": "action",
          "text": "Flaps \u2014 retract to reduce drag if altitude permits a controlled approach ahead",
          "response": "AS REQUIRED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-4"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF BEFORE TOUCHDOWN",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-5"
        },
        {
          "type": "action",
          "text": "Ignition",
          "response": "OFF BEFORE TOUCHDOWN",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-6"
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF BEFORE TOUCHDOWN",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-7"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF BEFORE TOUCHDOWN",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-8"
        },
        {
          "type": "note",
          "text": "Do not attempt to return to the runway unless altitude and glide performance clearly permit. A straight-ahead or shallow-turn landing is nearly always the safer choice.",
          "tickable": false,
          "id": "engine-failure-after-takeoff-9"
        }
      ]
    },
    {
      "id": "engine-failure-in-flight",
      "phase": "engine_failure_in_flight",
      "criticality": "emergency",
      "title": "Engine Failure in Flight",
      "items": [
        {
          "type": "action",
          "text": "Best glide airspeed \u2014 pitch for it immediately",
          "response": "ESTABLISHED PER POH",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-1"
        },
        {
          "type": "action",
          "text": "Landing area \u2014 identify most suitable field or surface within glide range",
          "response": "IDENTIFIED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-2"
        },
        {
          "type": "action",
          "text": "Fuel selector \u2014 confirm not accidentally moved to OFF",
          "response": "BOTH",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-3"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "RICH",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-4"
        },
        {
          "type": "action",
          "text": "Throttle \u2014 advance to full; check for partial power recovery",
          "response": "FULL; MONITOR RESPONSE",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-5"
        },
        {
          "type": "action",
          "text": "Ignition \u2014 cycle through LEFT and RIGHT individually to check for magneto failure",
          "response": "BOTH; CYCLE IF NO RESPONSE",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-6"
        },
        {
          "type": "action",
          "text": "Fuel quantity \u2014 verify remaining on both gauges; rule out fuel exhaustion",
          "response": "CONFIRMED FUEL REMAINING",
          "tickable": true,
          "id": "engine-failure-in-flight-7"
        },
        {
          "type": "action",
          "text": "Restart attempt \u2014 if probable cause identified, correct and retry before committing to forced landing",
          "response": "ATTEMPTED IF FEASIBLE",
          "tickable": true,
          "id": "engine-failure-in-flight-8"
        },
        {
          "type": "action",
          "text": "Squawk 7700 and declare emergency \u2014 transmit position, nature, and souls on board on 121.5 MHz or current frequency",
          "response": "DECLARED",
          "tickable": true,
          "id": "engine-failure-in-flight-9"
        },
        {
          "type": "action",
          "text": "Passenger briefing \u2014 brace position and emergency exit procedure",
          "response": "BRIEFED",
          "tickable": true,
          "id": "engine-failure-in-flight-10"
        },
        {
          "type": "action",
          "text": "If engine does not restart \u2014 execute forced landing procedure",
          "response": "PROCEED TO FORCED LANDING",
          "tickable": true,
          "id": "engine-failure-in-flight-11"
        }
      ]
    },
    {
      "id": "engine-fire-in-flight",
      "phase": "engine_fire_in_flight",
      "criticality": "emergency",
      "title": "Engine Fire in Flight",
      "items": [
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF \u2014 cut fuel to engine immediately",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-1"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-2"
        },
        {
          "type": "action",
          "text": "Throttle",
          "response": "CLOSE",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-3"
        },
        {
          "type": "action",
          "text": "Master and alternator switches",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-4"
        },
        {
          "type": "action",
          "text": "Cabin heat and air vents \u2014 close all cockpit airflow paths to deny fire fresh air into cabin",
          "response": "CLOSED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-5"
        },
        {
          "type": "action",
          "text": "Airspeed \u2014 increase toward maneuvering speed if fire persists; airflow may extinguish fire",
          "response": "INCREASED IF FIRE PERSISTS",
          "tickable": true,
          "id": "engine-fire-in-flight-6"
        },
        {
          "type": "action",
          "text": "Declare emergency and proceed to nearest suitable landing area without delay",
          "response": "MAYDAY DECLARED; LANDING AREA SELECTED",
          "tickable": true,
          "id": "engine-fire-in-flight-7"
        },
        {
          "type": "action",
          "text": "Seat belts \u2014 all occupants secured and braced",
          "response": "SECURE",
          "tickable": true,
          "id": "engine-fire-in-flight-8"
        }
      ]
    },
    {
      "id": "engine-fire-ground",
      "phase": "engine_fire_ground",
      "criticality": "emergency",
      "title": "Engine Fire on Ground",
      "items": [
        {
          "type": "action",
          "text": "Throttle \u2014 advance briefly to attempt to draw fire back through induction, then close",
          "response": "ADVANCED BRIEFLY THEN CLOSED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-1"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-2"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-3"
        },
        {
          "type": "action",
          "text": "Ignition",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-4"
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-5"
        },
        {
          "type": "action",
          "text": "Evacuate \u2014 all occupants exit immediately and move upwind to safe distance",
          "response": "EVACUATED UPWIND",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-6"
        },
        {
          "type": "action",
          "text": "Fire extinguisher \u2014 use on engine if accessible and fire is not endangering personnel",
          "response": "USED IF SAFE TO DO SO",
          "tickable": true,
          "id": "engine-fire-ground-7"
        },
        {
          "type": "action",
          "text": "Emergency services \u2014 call fire/rescue; do not re-enter aircraft if fire persists",
          "response": "CALLED",
          "tickable": true,
          "id": "engine-fire-ground-8"
        }
      ]
    },
    {
      "id": "electrical-fire",
      "phase": "electrical_fire",
      "criticality": "emergency",
      "title": "Electrical Fire / Smoke in Cockpit",
      "items": [
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF \u2014 remove all power from bus",
          "tickable": true,
          "memory_item": true,
          "id": "electrical-fire-1"
        },
        {
          "type": "action",
          "text": "All electrical switches",
          "response": "OFF \u2014 cycle all off before any power restoration",
          "tickable": true,
          "memory_item": true,
          "id": "electrical-fire-2"
        },
        {
          "type": "action",
          "text": "Vents \u2014 open fresh-air vents to ventilate cockpit and clear smoke",
          "response": "OPEN",
          "tickable": true,
          "memory_item": true,
          "id": "electrical-fire-3"
        },
        {
          "type": "action",
          "text": "Fire extinguisher \u2014 use if source is visible and accessible; aim at base of flame",
          "response": "USED AS NEEDED",
          "tickable": true,
          "id": "electrical-fire-4"
        },
        {
          "type": "action",
          "text": "Master switch \u2014 if flight requires electrical power, restore; turn equipment on one item at a time, watching for recurrence",
          "response": "RESTORED SELECTIVELY IF ESSENTIAL",
          "tickable": true,
          "id": "electrical-fire-5"
        },
        {
          "type": "action",
          "text": "Avionics master \u2014 leave OFF unless essential for navigation or ATC communication",
          "response": "OFF UNLESS ESSENTIAL",
          "tickable": true,
          "id": "electrical-fire-6"
        },
        {
          "type": "action",
          "text": "Land as soon as practicable \u2014 declare emergency; do not continue flight with unresolved electrical fire or smoke",
          "response": "LANDING INITIATED",
          "tickable": true,
          "id": "electrical-fire-7"
        }
      ]
    },
    {
      "id": "oil-system-malfunction",
      "phase": "oil_system_malfunction",
      "criticality": "emergency",
      "title": "Loss of Oil Pressure",
      "items": [
        {
          "type": "action",
          "text": "Oil pressure gauge \u2014 confirm reading; cross-check oil temperature for simultaneous rise indicating real oil loss vs. gauge failure",
          "response": "CONFIRMED LOW",
          "tickable": true,
          "memory_item": true,
          "id": "oil-system-malfunction-1"
        },
        {
          "type": "action",
          "text": "Throttle \u2014 reduce power to minimum required for continued flight",
          "response": "REDUCED",
          "tickable": true,
          "memory_item": true,
          "id": "oil-system-malfunction-2"
        },
        {
          "type": "action",
          "text": "Nearest suitable landing area \u2014 identify and proceed toward it without delay",
          "response": "IDENTIFIED AND PROCEEDING",
          "tickable": true,
          "memory_item": true,
          "id": "oil-system-malfunction-3"
        },
        {
          "type": "action",
          "text": "Treat engine as potentially seconds from seizure if pressure is zero and temperature is rising \u2014 do not delay landing",
          "response": "LANDING PRIORITY CONFIRMED",
          "tickable": true,
          "memory_item": true,
          "id": "oil-system-malfunction-4"
        },
        {
          "type": "action",
          "text": "ATC \u2014 advise of situation; squawk 7700",
          "response": "ADVISED",
          "tickable": true,
          "id": "oil-system-malfunction-5"
        },
        {
          "type": "action",
          "text": "Forced landing \u2014 execute before engine failure if pressure cannot be restored; a controlled power-on landing is preferable to a power-off arrival",
          "response": "EXECUTING IF NOT RESTORED",
          "tickable": true,
          "id": "oil-system-malfunction-6"
        }
      ]
    },
    {
      "id": "forced-landing",
      "phase": "forced_landing",
      "criticality": "emergency",
      "title": "Forced Landing (Power-Off)",
      "items": [
        {
          "type": "action",
          "text": "Best glide airspeed \u2014 establish and maintain per POH",
          "response": "ESTABLISHED PER POH",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-1"
        },
        {
          "type": "action",
          "text": "Landing area \u2014 select largest, smoothest surface available into the wind; avoid power lines, fences, ditches, and sloped terrain",
          "response": "SELECTED",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-2"
        },
        {
          "type": "action",
          "text": "Squawk 7700 and declare Mayday \u2014 transmit aircraft type, position, nature of emergency, and souls on board on 121.5 MHz or current frequency",
          "response": "DECLARED",
          "tickable": true,
          "id": "forced-landing-3"
        },
        {
          "type": "action",
          "text": "ELT \u2014 activate manually if time permits",
          "response": "ACTIVATED",
          "tickable": true,
          "id": "forced-landing-4"
        },
        {
          "type": "action",
          "text": "Passenger briefing \u2014 brace position, seat belts tight, door unlatched before touchdown",
          "response": "BRIEFED",
          "tickable": true,
          "id": "forced-landing-5"
        },
        {
          "type": "action",
          "text": "Flaps \u2014 deploy incrementally when landing is assured; full flaps for shortest roll-out if obstacle clearance is not a factor",
          "response": "SET AS REQUIRED",
          "tickable": true,
          "id": "forced-landing-6"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF ON SHORT FINAL",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-7"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF ON SHORT FINAL",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-8"
        },
        {
          "type": "action",
          "text": "Ignition",
          "response": "OFF JUST BEFORE TOUCHDOWN",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-9"
        },
        {
          "type": "action",
          "text": "Master switch \u2014 OFF just before touchdown, unless ELT is transmitting via aircraft power",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-10"
        },
        {
          "type": "action",
          "text": "Doors \u2014 unlatch prior to touchdown to prevent jamming in a deformed airframe",
          "response": "UNLATCHED",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-11"
        },
        {
          "type": "action",
          "text": "Touchdown attitude \u2014 minimum airspeed, tail-low; absorb impact through landing gear rather than nose-first",
          "response": "TAIL-LOW AT MINIMUM SPEED",
          "tickable": true,
          "id": "forced-landing-12"
        },
        {
          "type": "action",
          "text": "Post-landing \u2014 exit aircraft upwind; move well clear; activate ELT if not already transmitting",
          "response": "EVACUATED UPWIND",
          "tickable": true,
          "id": "forced-landing-13"
        }
      ]
    }
  ]
}