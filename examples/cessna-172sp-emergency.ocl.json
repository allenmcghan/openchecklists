{
  "open_checklist_version": "1.0",
  "id": "cessna-172sp-emergency",
  "title": "Cessna 172 SP \u2014 Emergency Procedures",
  "description": "Emergency procedures for the Cessna 172 SP with Lycoming IO-360 fuel-injected engine. Memory items are marked accordingly. Contains no numeric limitations; all airspeeds and power settings must come from the specific aircraft POH. The IO-360 is fuel-injected \u2014 there is no carburetor and no carburetor heat; carburetor ice is not applicable and is omitted.",
  "aircraft": {
    "make": "Cessna",
    "model": "172",
    "variant": "SP",
    "icao_type": "C172",
    "category": "standard_normal",
    "engine": [
      {
        "make": "Lycoming",
        "model": "IO-360",
        "type": "piston_4stroke",
        "count": 1
      }
    ],
    "propeller": "fixed_pitch",
    "gear": "fixed_tricycle"
  },
  "units": {
    "airspeed": "kt",
    "altitude": "ft",
    "fuel": "usgal",
    "weight": "lb",
    "pressure": "inhg",
    "temperature": "f"
  },
