    {
      "phase": "reference",
      "title": "Aerobatics and Handling",
      "criticality": "normal",
      "items": [
        {
          "type": "note",
          "text": "Ailerons and elevator are light and responsive, though the rudder is heavier. Full aileron requires only about forty degrees deflection either way.",
          "tickable": false,
          "source_confidence": 1.0
        },
        {
          "type": "note",
          "text": "The test aircraft had no inverted oil system, so no negative manoeuvres were permitted. An inverted oil system is an option.",
          "tickable": false,
          "source_confidence": 1.0
        },
        {
          "type": "note",
          "text": "G limits are +6.4/-3.2g.",
          "tickable": false,
          "source_confidence": 1.0
        }
      ]
    },
    {
