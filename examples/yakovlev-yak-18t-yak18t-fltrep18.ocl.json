        },
        {
          "type": "action",
          "text": "After two or three blades have passed the vertical, magneto switch",
          "response": "TURN ANTICLOCKWISE TO 1+2",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "action",
          "text": "Throttle (to get all nine cylinders on line)",
          "response": "JUDICIOUSLY PUMP",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "action",
          "text": "Engine idle",
          "response": "AROUND 30 PER CENT",
          "tickable": true,
