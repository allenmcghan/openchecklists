        }
      ]
    },
    {
      "phase": "taxi",
      "title": "Taxying",
      "criticality": "normal",
      "items": [
        {
          "type": "note",
          "text": "Taxying requires a degree of initial concentration, at least until the braking system is mastered for turning.",
          "tickable": false,
          "source_confidence": 1.0
        },
        {
          "type": "note",
          "text": "No nose-wheel steering: to initiate a turn requires differential braking by pressing the appropriate rudder pedal, then squeezing the brake lever.",
