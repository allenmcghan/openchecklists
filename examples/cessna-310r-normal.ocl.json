  "sections": [
    {
      "id": "preflight-inspection",
      "phase": "preflight_inspection",
      "title": "Preflight Walk-Around",
      "items": [
        { "type": "action", "id": "preflight-1", "text": "Aircraft documents (AROW)", "response": "ON BOARD AND CURRENT", "tickable": true },
        { "type": "action", "id": "preflight-2", "text": "Fuel quantity — visually inspect both main and aux tanks; confirm caps seated and locked", "response": "VERIFIED — QUANTITY ADEQUATE FOR FLIGHT WITH RESERVES", "tickable": true },
        { "type": "action", "id": "preflight-3", "text": "Fuel sump drains — all sumps on both wings and gascolator", "response": "SAMPLED; CLEAR, CORRECT COLOR, NO WATER OR SEDIMENT", "tickable": true },
        { "type": "action", "id": "preflight-4", "text": "Fuel selector valves — both engines", "response": "CONFIRMED ACCESSIBLE; POSITION NOTED", "tickable": true },
        { "type": "action", "id": "preflight-5", "text": "Oil level — left engine", "response": "WITHIN ACCEPTABLE RANGE PER POH; CAP SECURE", "tickable": true },
        { "type": "action", "id": "preflight-6", "text": "Left engine cowling and induction inlets", "response": "LATCHES SECURE; INLETS CLEAR OF OBSTRUCTIONS", "tickable": true },
        { "type": "action", "id": "preflight-7", "text": "Left propeller blades and spinner", "response": "NO NICKS, CRACKS, OR EROSION; SPINNER SECURE", "tickable": true },
        { "type": "action", "id": "preflight-8", "text": "Left main landing gear — strut, tire, and gear door", "response": "STRUT EXTENDED NORMALLY; TIRE SERVICEABLE; DOOR CONDITION ACCEPTABLE", "tickable": true },
        { "type": "action", "id": "preflight-9", "text": "Left wing — leading edge, fuel vent, tip, and nav light", "response": "NO DAMAGE; VENT CLEAR; LIGHT LENS INTACT", "tickable": true },
        { "type": "action", "id": "preflight-10", "text": "Left aileron and flap — hinge points, fasteners, and travel", "response": "SECURE; FULL FREE MOVEMENT; NO DAMAGE", "tickable": true },
        { "type": "action", "id": "preflight-11", "text": "Static ports", "response": "CLEAR AND UNOBSTRUCTED", "tickable": true },
        { "type": "action", "id": "preflight-12", "text": "Pitot tube — cover removed, inlet clear", "response": "COVER OFF; UNOBSTRUCTED", "tickable": true },
        { "type": "action", "id": "preflight-13", "text": "Nose gear — strut extension, tire condition, steering linkage, and shimmy damper", "response": "STRUT EXTENDED NORMALLY; TIRE SERVICEABLE; LINKAGE INTACT", "tickable": true },
        { "type": "action", "id": "preflight-14", "text": "Nose baggage compartment", "response": "CONTENTS SECURE; DOOR LATCHED", "tickable": true },
        { "type": "action", "id": "preflight-15", "text": "Oil level — right engine", "response": "WITHIN ACCEPTABLE RANGE PER POH; CAP SECURE", "tickable": true },
        { "type": "action", "id": "preflight-16", "text": "Right engine cowling and induction inlets", "response": "LATCHES SECURE; INLETS CLEAR", "tickable": true },
        { "type": "action", "id": "preflight-17", "text": "Right propeller blades and spinner", "response": "NO NICKS, CRACKS, OR EROSION; SPINNER SECURE", "tickable": true },
        { "type": "action", "id": "preflight-18", "text": "Right main landing gear — strut, tire, and gear door", "response": "STRUT EXTENDED NORMALLY; TIRE SERVICEABLE; DOOR CONDITION ACCEPTABLE", "tickable": true },
        { "type": "action", "id": "preflight-19", "text": "Right wing, aileron, flap, and nav light", "response": "NO DAMAGE; HINGES SECURE; FULL FREE MOVEMENT; LENS INTACT", "tickable": true },
        { "type": "action", "id": "preflight-20", "text": "Empennage — horizontal and vertical stabilizer surfaces", "response": "NO DAMAGE; HINGE POINTS SECURE", "tickable": true },
        { "type": "action", "id": "preflight-21", "text": "Elevator, rudder, and trim tabs", "response": "FREE OF DAMAGE; TRAVEL FREE; TRIM TABS SECURE", "tickable": true },
        { "type": "action", "id": "preflight-22", "text": "All tiedowns, chocks, and control locks", "response": "REMOVED", "tickable": true }
