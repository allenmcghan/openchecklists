    {
      "phase": "icing",
      "phase_label": "Inadvertent Icing Encounter",
      "title": "Inadvertent Icing Encounter",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Turn Pitot heat Switch",
          "response": "ON",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Turn back or change altitude to obtain an outside air temperature that is less conducive to icing.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Pull cabin heat control full out & open defroster outlets to obtain maximum windshield defroster airflow. Adjust cabin air control to get maximum defroster heat & airflow.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Watch for signs of engine-related icing conditions. An unexplained loss in engine speed could be caused by ice blocking the air intake filter or, in extremely rare instances, ice completely blocking the fuel injection air reference tubes. Change the throttle position to obtain maximum RPM. This may require either advancing or retarding the throttle, dependent on where ice has accumulated in the system. Adjust mixture, as required, for maximum RPM.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Plan a landing at the nearest airport. With an extremely rapid ice build up, select a suitable “off airport” landing site.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "With an ice accumulation of ¼ inch or more on the wing leading edges, be prepared for significantly higher stall speed and a longer landing roll.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Leave wing flaps retracted. With a severe ice build up on the horizontal tail, the change in wing wake airflow direction caused by wing flap extension could result in a loss of elevator effectiveness.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Open left window and, if practical, scrape ice from the portion of the windshield for visibility in the landing approach.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Perform a landing approach using a forward slip, if necessary, for improved visibility.",
          "tickable": true,
          "source_confidence": 1.0
        },
        {
          "type": "challenge",
          "text": "Approach at 65 to 75 KIAS depending upon the amount of the accumulation.",
          "tickable": true,
          "source_confidence": 0.5
        },
        {
          "type": "challenge",
          "text": "Perform a landing in level attitude.",
          "tickable": true,
          "source_confidence": 1.0
        }
      ]
    },
