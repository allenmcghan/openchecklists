{
  "open_checklist_version": "1.0",
  "id": "faa-sep-normal-ops",
  "title": "Generic Single-Engine Piston — Normal Procedures (FAA Airplane Flying Handbook)",
  "description": "A type-generic normal-operations checklist for land-based single-engine piston airplanes, assembled from the FAA Airplane Flying Handbook (FAA-H-8083-3C), a US Government work in the public domain. Extends examples/faa-generic-sep-ground-operations.ocl.json with a preflight inspection sequence and engine start, and adds a shutdown section. Not a substitute for the AFM/POH of any specific aircraft: the Handbook directs the pilot to the aircraft's own checklist for all specific values.",
  "aircraft": {
    "make": "Generic",
    "model": "Single-Engine Piston",
    "category": "standard_normal",
    "engine": [
      {
        "make": "Generic",
        "model": "Piston",
        "type": "piston_4stroke",
        "count": 1
      }
    ],
    "gear": "fixed_tricycle"
  },
  "units": {
    "airspeed": "kt",
    "altitude": "ft",
    "fuel": "usgal",
    "weight": "lb",
    "pressure": "inhg",
    "temperature": "f"
  },
