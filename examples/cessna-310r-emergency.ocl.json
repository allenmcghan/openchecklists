  "sections": [
    {
      "id": "engine-failure-before-rotation",
      "phase": "engine_failure_before_rotation",
      "title": "Engine Failure on Takeoff \u2014 Before / At Rotation",
      "items": [
        {
          "type": "action",
          "id": "efbr-1",
          "text": "Throttles \u2014 both",
          "response": "IDLE IMMEDIATELY",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efbr-2",
          "text": "Brakes",
          "response": "APPLY FIRMLY; REMAIN ON RUNWAY",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "caution",
          "text": "If airborne at low speed below obstacle clearance: land ahead on remaining runway or suitable area. Do not attempt single-engine climb at low speed.",
          "tickable": false
        },
        {
          "type": "action",
          "id": "efbr-3",
          "text": "Directional control",
          "response": "APPLY RUDDER TOWARD OPERATING ENGINE; MAINTAIN WINGS LEVEL",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efbr-4",
          "text": "Airspeed \u2014 if airborne",
          "response": "MAINTAIN AT OR ABOVE VYSE (BLUE LINE); NEVER LET SPEED DECAY TOWARD VMC",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efbr-5",
          "text": "Landing gear \u2014 if climb is established",
          "response": "RETRACT AFTER POSITIVE CLIMB CONFIRMED AND RUNWAY NO LONGER AVAILABLE",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efbr-6",
          "text": "Flaps",
          "response": "RETRACT INCREMENTALLY AS SPEED AND ALTITUDE PERMIT",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efbr-7",
          "text": "Identify failed engine",
          "response": "DEAD FOOT \u2014 DEAD ENGINE: FOOT WITH REDUCED RUDDER PRESSURE IDENTIFIES FAILED ENGINE",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efbr-8",
          "text": "Continue with engine failure in flight checklist",
          "response": "ONCE ABOVE OBSTACLE CLEARANCE AND AT VYSE",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "engine-failure-in-flight",
      "phase": "engine_failure_in_flight",
      "title": "Engine Failure in Flight \u2014 Identify / Verify / Feather / Secure",
      "items": [
        {
          "type": "action",
          "id": "efif-1",
          "text": "Airspeed \u2014 pitch immediately",
          "response": "MAINTAIN AT OR ABOVE VYSE; ACCEPT ALTITUDE LOSS IF NEEDED TO HOLD BLUE LINE",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efif-2",
          "text": "Identify failed engine",
          "response": "DEAD FOOT \u2014 DEAD ENGINE: REDUCED RUDDER PEDAL LOAD IDENTIFIES THE FAILED SIDE; CONFIRM WITH ENGINE INSTRUMENTS",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efif-3",
          "text": "Operating engine \u2014 verify at full power",
          "response": "THROTTLE, PROPELLER, AND MIXTURE: FULL / FULL / RICH",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efif-4",
          "text": "Failed engine \u2014 verify identification before feathering",
          "response": "SMOOTHLY RETARD SUSPECT THROTTLE: NO CHANGE IN YAW CONFIRMS THE FAILED ENGINE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-5",
          "text": "Failed engine \u2014 fuel selector",
          "response": "SWITCH TO FULLEST MAIN TANK IF NOT ALREADY SET",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-6",
          "text": "Failed engine \u2014 fuel pump",
          "response": "ON \u2014 CHECK FOR RESTORATION OF POWER",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-7",
          "text": "Failed engine \u2014 mixture",
          "response": "RICH \u2014 CONFIRM",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-8",
          "text": "Failed engine \u2014 magnetos",
          "response": "BOTH \u2014 CONFIRM",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-9",
          "text": "Failed engine \u2014 restart attempt",
          "response": "ATTEMPT IF CAUSE UNKNOWN AND CONDITIONS PERMIT; IF FIRE OR RESTART FAILS, PROCEED TO FEATHER",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-10",
          "text": "Failed engine \u2014 propeller control",
          "response": "FEATHER AFTER CONFIRMING IDENTIFICATION AND FAILED RESTART",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efif-11",
          "text": "Failed engine \u2014 throttle",
          "response": "CLOSE AFTER FEATHERING",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-12",
          "text": "Failed engine \u2014 mixture",
          "response": "IDLE CUT-OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-13",
          "text": "Failed engine \u2014 fuel selector",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-14",
          "text": "Failed engine \u2014 fuel pump",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-15",
          "text": "Failed engine \u2014 alternator",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-16",
          "text": "Failed engine \u2014 magnetos",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-17",
          "text": "Operating engine \u2014 cowl flap",
          "response": "OPEN AS NEEDED FOR TEMPERATURE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-18",
          "text": "Rudder trim",
          "response": "TRIM TO REDUCE PEDAL LOAD TOWARD OPERATING ENGINE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efif-19",
          "text": "Altitude and airspeed assessment",
          "response": "MAINTAIN VYSE; DETERMINE WHETHER ALTITUDE CAN BE MAINTAINED; DECLARE EMERGENCY IF REQUIRED; DIVERT TO NEAREST SUITABLE AIRPORT",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "engine-fire-in-flight",
      "phase": "engine_fire_in_flight",
      "title": "Engine Fire in Flight",
      "items": [
        {
          "type": "action",
          "id": "efire-if-1",
          "text": "Throttle \u2014 affected engine",
          "response": "CLOSE IMMEDIATELY",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-if-2",
          "text": "Mixture \u2014 affected engine",
          "response": "IDLE CUT-OFF \u2014 CUT FUEL TO FIRE",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-if-3",
          "text": "Fuel selector \u2014 affected engine",
          "response": "OFF \u2014 STOP FUEL SUPPLY",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-if-4",
          "text": "Fuel pump \u2014 affected engine",
          "response": "OFF",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-if-5",
          "text": "Propeller \u2014 affected engine",
          "response": "FEATHER",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-if-6",
          "text": "Alternator \u2014 affected engine",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-if-7",
          "text": "Airspeed \u2014 increase if altitude permits",
          "response": "INCREASE TO AID FIRE SUPPRESSION THROUGH AIRFLOW",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-if-8",
          "text": "Fire extinguisher \u2014 if fire continues",
          "response": "DISCHARGE INTO NACELLE IF ACCESSIBLE AND PER AIRCRAFT EQUIPMENT",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-if-9",
          "text": "If fire does not extinguish",
          "response": "DECLARE MAYDAY; PREPARE FOR FORCED LANDING AT NEAREST SUITABLE AIRPORT OR FIELD",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-if-10",
          "text": "Operating engine",
          "response": "MAINTAIN APPROPRIATE POWER; CONTINUE SINGLE-ENGINE APPROACH AND LANDING",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "engine-fire-ground",
      "phase": "engine_fire_ground",
      "title": "Engine Fire on Ground",
      "items": [
        {
          "type": "action",
          "id": "efire-gnd-1",
          "text": "Affected engine throttle \u2014 advance momentarily then close",
          "response": "ADVANCE BRIEFLY TO DRAW FIRE BACK THROUGH INTAKE; THEN IDLE CUT-OFF",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-gnd-2",
          "text": "Fuel selector \u2014 affected engine",
          "response": "OFF",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-gnd-3",
          "text": "Fuel pump \u2014 affected engine",
          "response": "OFF",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "efire-gnd-4",
          "text": "Fire extinguisher \u2014 ground",
          "response": "DISCHARGE ONTO COWLING; USE AIRCRAFT FIRE BOTTLE IF EQUIPPED",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-gnd-5",
          "text": "Master switch \u2014 if fire cannot be immediately controlled",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-gnd-6",
          "text": "Evacuate all occupants",
          "response": "EXIT AIRCRAFT; MOVE UPWIND AND AWAY FROM FUEL TANKS",
          "tickable": true
        },
        {
          "type": "action",
          "id": "efire-gnd-7",
          "text": "Emergency services",
          "response": "CALL 911 / AIRPORT FIRE AND RESCUE",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "electrical-fire",
      "phase": "electrical_fire",
      "title": "Electrical Fire / Smoke in Cockpit",
      "items": [
        {
          "type": "action",
          "id": "elec-fire-1",
          "text": "Master switch",
          "response": "OFF \u2014 REMOVE POWER FROM ALL ELECTRICAL SYSTEMS",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "elec-fire-2",
          "text": "Avionics master",
          "response": "OFF",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "elec-fire-3",
          "text": "All electrical switches",
          "response": "OFF \u2014 ELIMINATE IGNITION SOURCES",
          "tickable": true
        },
        {
          "type": "action",
          "id": "elec-fire-4",
          "text": "Fresh-air vents",
          "response": "OPEN TO CLEAR SMOKE \u2014 PROVIDED AIRFLOW DOES NOT FEED THE FIRE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "elec-fire-5",
          "text": "Fire extinguisher",
          "response": "USE HALON OR APPROVED AGENT",
          "tickable": true
        },
        {
          "type": "action",
          "id": "elec-fire-6",
          "text": "Restore minimum electrical systems",
          "response": "RE-ENERGIZE ONE CIRCUIT AT A TIME TO IDENTIFY AND ISOLATE FAULTY CIRCUIT",
          "tickable": true
        },
        {
          "type": "action",
          "id": "elec-fire-7",
          "text": "Divert and land",
          "response": "NEAREST SUITABLE AIRPORT; DECLARE EMERGENCY",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "oil-system-malfunction",
      "phase": "oil_system_malfunction",
      "title": "Loss of Oil Pressure",
      "items": [
        {
          "type": "action",
          "id": "oil-1",
          "text": "Identify affected engine",
          "response": "NOTE WHICH OIL PRESSURE GAUGE IS LOW OR ZERO",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "oil-2",
          "text": "Affected engine \u2014 power reduction",
          "response": "REDUCE TO MINIMUM POWER REQUIRED; DO NOT OPERATE AT HIGH POWER WITHOUT OIL PRESSURE",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "oil-3",
          "text": "Oil temperature \u2014 affected engine",
          "response": "MONITOR: RISING TEMP WITH LOW PRESSURE CONFIRMS OIL SYSTEM FAILURE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "oil-4",
          "text": "Decision \u2014 if pressure remains abnormally low",
          "response": "SHUT DOWN AFFECTED ENGINE PER ENGINE FAILURE IN FLIGHT PROCEDURE; DO NOT WAIT FOR SEIZURE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "oil-5",
          "text": "Divert",
          "response": "PROCEED TO NEAREST SUITABLE AIRPORT; DECLARE EMERGENCY AS APPROPRIATE",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "icing",
      "phase": "icing",
      "title": "Induction System Anomaly (TSIO-520 Fuel-Injected)",
      "items": [
        {
          "type": "note",
          "text": "Continental TSIO-520 is fuel-injected \u2014 classic carburetor ice does not apply. Monitor for induction icing or alternate air door function as equipped per POH.",
          "tickable": false
        },
        {
          "type": "action",
          "id": "icing-1",
          "text": "Unexplained power loss \u2014 one or both engines",
          "response": "CHECK ALTERNATE INDUCTION AIR SOURCE IF EQUIPPED; CHECK THROTTLE, MIXTURE, FUEL SELECTOR, AND FUEL PUMP",
          "tickable": true
        },
        {
          "type": "action",
          "id": "icing-2",
          "text": "Mixture \u2014 verify",
          "response": "RICH \u2014 RULE OUT MIXTURE-INDUCED POWER LOSS",
          "tickable": true
        },
        {
          "type": "action",
          "id": "icing-3",
          "text": "If power is not restored",
          "response": "TREAT AS PARTIAL ENGINE FAILURE; MAINTAIN VYSE; DIVERT TO NEAREST AIRPORT",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "forced-landing",
      "phase": "forced_landing",
      "title": "Forced Landing (Power-Off)",
      "items": [
        {
          "type": "action",
          "id": "forced-1",
          "text": "Declare emergency \u2014 transmit position, altitude, and intentions",
          "response": "MAYDAY ON 121.5 OR ASSIGNED FREQUENCY",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "forced-2",
          "text": "Transponder",
          "response": "7700",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "forced-3",
          "text": "Best glide speed",
          "response": "ESTABLISH PER POH IMMEDIATELY TO MAXIMIZE GLIDE RANGE",
          "tickable": true,
          "memory_item": true
        },
        {
          "type": "action",
          "id": "forced-4",
          "text": "Landing area selection",
          "response": "LONGEST AND SMOOTHEST AREA AVAILABLE; INTO WIND IF POSSIBLE",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-5",
          "text": "Fuel selectors \u2014 both",
          "response": "OFF TO REDUCE FIRE RISK",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-6",
          "text": "Mixtures \u2014 both",
          "response": "IDLE CUT-OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-7",
          "text": "Landing gear",
          "response": "DOWN FOR SUITABLE SURFACE LANDING; CONSIDER GEAR UP FOR SOFT OR ROUGH TERRAIN PER CONDITIONS",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-8",
          "text": "Flaps",
          "response": "EXTEND ON FINAL TO REDUCE TOUCHDOWN SPEED",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-9",
          "text": "Master switch and ignition \u2014 before touchdown",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-10",
          "text": "Doors \u2014 before touchdown",
          "response": "UNLATCH TO PREVENT JAMMING",
          "tickable": true
        },
        {
          "type": "action",
          "id": "forced-11",
          "text": "Touchdown \u2014 at minimum controllable airspeed",
          "response": "MAINTAIN DIRECTIONAL CONTROL THROUGH ROLLOUT",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "landing-gear-malfunction",
      "phase": "landing_gear_malfunction",
      "title": "Gear Unsafe / Gear Failure",
      "items": [
        {
          "type": "action",
          "id": "gear-unsafe-1",
          "text": "Gear handle and circuit breaker",
          "response": "HANDLE CONFIRMED DOWN; GEAR CIRCUIT BREAKER IN",
          "tickable": true
        },
        {
          "type": "action",
          "id": "gear-unsafe-2",
          "text": "Gear indicator lights \u2014 note which legs indicate",
          "response": "GREEN / RED / NO LIGHT NOTED FOR EACH LEG",
          "tickable": true
        },
        {
          "type": "action",
          "id": "gear-unsafe-3",
          "text": "Airspeed \u2014 confirm below maximum gear operating speed",
          "response": "SLOW AS NEEDED",
          "tickable": true
        },
        {
          "type": "action",
          "id": "gear-unsafe-4",
          "text": "Gear recycle \u2014 raise then lower gear handle",
          "response": "THREE GREEN IF EXTENSION NOW COMPLETE; IF NOT, PROCEED TO EMERGENCY EXTENSION",
          "tickable": true
        },
        {
          "type": "action",
          "id": "gear-unsafe-5",
          "text": "Tower or traffic inspection",
          "response": "REQUEST VISUAL CONFIRMATION OF GEAR POSITION IF STILL UNCERTAIN",
          "tickable": true
        },
        {
          "type": "action",
          "id": "gear-unsafe-6",
          "text": "If normal extension fails",
          "response": "PROCEED TO EMERGENCY GEAR EXTENSION PROCEDURE",
          "tickable": true
        }
      ],
      "criticality": "emergency"
    },
    {
      "id": "emergency-gear-extension",
      "phase": "landing_gear_malfunction",
      "title": "Emergency Gear Extension",
      "items": [
        {
          "type": "action",
          "id": "ege-1",
          "text": "Airspeed \u2014 reduce below maximum gear extension speed per POH",
          "response": "SPEED REDUCED",
          "tickable": true
        },
        {
          "type": "action",
          "id": "ege-2",
          "text": "Gear circuit breaker",
          "response": "VERIFY IN; RESET IF TRIPPED",
          "tickable": true
        },
        {
          "type": "action",
          "id": "ege-3",
          "text": "Emergency gear extension \u2014 operate per POH",
          "response": "HAND PUMP / CO2 SYSTEM / MANUAL CRANK AS APPLICABLE TO THIS AIRCRAFT",
          "tickable": true
        },
        {
          "type": "action",
          "id": "ege-4",
          "text": "Gear indicator lights \u2014 confirm three green",
          "response": "ALLOW ADEQUATE TIME FOR GEAR TO LOCK; THREE GREEN CONFIRMED",
          "tickable": true
        },
        {
          "type": "action",
          "id": "ege-5",
