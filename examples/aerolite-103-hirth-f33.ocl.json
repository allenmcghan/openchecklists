{
  "open_checklist_version": "1.0",
  "id": "aerolite-103-hirth-f33",
  "title": "Aerolite 103 (Hirth F-33) — Normal and Emergency Procedures",
  "description": "A Part 103 ultralight checklist covering the class of aircraft the vendor formats and the existing free repositories do not serve. AUTHORED, NOT TRANSCRIBED: no manufacturer document was available to the transcriber. The wording is original, the sequence reflects general single-cylinder two-stroke ultralight practice, and no value here has been checked against the manufacturer's assembly or operating manual. It exists to exercise the schema and to make the shape of the gap concrete. It is not airworthy and must not be flown behind.",
  "aircraft": {
    "make": "U-Fly-It Light Sport Aircraft",
    "model": "Aerolite 103",
    "category": "part103_ultralight",
    "engine": [
      {
        "make": "Hirth",
        "model": "F-33",
        "type": "piston_2stroke",
        "count": 1
      }
    ],
    "propeller": "ground_adjustable",
    "gear": "fixed_tricycle"
  },
  "units": {
    "airspeed": "mph",
    "altitude": "ft",
    "fuel": "usgal",
    "weight": "lb",
    "temperature": "f"
  },
  "provenance": {
    "source": {
      "kind": "none",
      "notes": "No manufacturer operating handbook, assembly manual, or engine manual was consulted. Airframe identification and engine option come from the manufacturer's published specification page and from the type's Wikipedia entry; the procedures themselves are the transcriber's own composition from general two-stroke ultralight practice. Every number in this file is a placeholder pending a real source. Aircraft operated under 14 CFR Part 103 are not required to have an approved flight manual at all, which is precisely why no authoritative source document exists to transcribe."
    },
    "transcription": {
      "method": "authored",
