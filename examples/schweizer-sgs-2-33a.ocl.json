      {
        "severity": "safety_defect",
        "description": "No airspeeds or weight limits. Club and site procedures for signals, release points and pattern entry vary and override anything here.",
        "location": "whole file"
      },
      {
        "severity": "content_gap",
        "description": "Aerotow only. No winch or auto-tow launch procedures, and no spin recovery section.",
