    "weight": "lb"
  },
  "provenance": {
    "source": {
      "kind": "none",
      "notes": "No Schweizer flight manual was consulted. Written from general knowledge of two-seat training glider operations and standard US signals and procedures. Weak-link and placard limitations, and all airspeeds, are omitted: they belong to the individual glider's flight manual and weight-and-balance paperwork."
    },
    "transcription": {
      "method": "authored",
