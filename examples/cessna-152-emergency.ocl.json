  "sections": [
    {
      "id": "engine-failure-before-rotation",
      "phase": "engine_failure_before_rotation",
      "title": "Engine Failure on Takeoff Roll (Before Lift-Off)",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Throttle",
          "response": "CLOSED IMMEDIATELY",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-mem-1"
        },
        {
          "type": "action",
          "text": "Brakes",
          "response": "APPLY FIRMLY TO STOP ON REMAINING RUNWAY",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-mem-2"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-mem-3"
        },
        {
          "type": "action",
          "text": "Ignition switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-mem-4"
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-before-rotation-mem-5"
        },
        {
          "type": "challenge",
          "text": "If unable to stop on runway, steer to minimize hazard to occupants and avoid populated areas",
          "tickable": true
        }
      ]
    },
    {
      "id": "engine-failure-after-takeoff",
      "phase": "engine_failure_after_takeoff",
      "title": "Engine Failure After Lift-Off",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Airspeed",
          "response": "BEST GLIDE \u2014 ESTABLISH IMMEDIATELY",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-mem-1"
        },
        {
          "type": "caution",
          "text": "Do not attempt to turn back to the runway at low altitude. Land approximately straight ahead or with minor heading changes to avoid obstacles.",
          "tickable": false
        },
        {
          "type": "action",
          "text": "Landing area \u2014 select best available field ahead and within the glide",
          "response": "SELECTED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-mem-3"
        },
        {
          "type": "action",
          "text": "Throttle",
          "response": "CLOSED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-mem-4"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF when landing is assured",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-after-takeoff-mem-5"
        },
        {
          "type": "action",
          "text": "Ignition switch",
          "response": "OFF when landing is assured",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF before touchdown",
          "tickable": true
        }
      ]
    },
    {
      "id": "engine-failure-in-flight",
      "phase": "engine_failure_in_flight",
      "title": "Engine Failure in Flight",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Airspeed",
          "response": "BEST GLIDE PER POH \u2014 ESTABLISH IMMEDIATELY",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-mem-1"
        },
        {
          "type": "action",
          "text": "Landing area",
          "response": "IDENTIFY SUITABLE FIELD WITHIN GLIDING RANGE",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-mem-2"
        },
        {
          "type": "action",
          "text": "Carburetor heat",
          "response": "FULL HOT \u2014 check for ice as cause of failure",
          "tickable": true,
          "memory_item": true,
          "id": "engine-failure-in-flight-mem-3"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "CONFIRM BOTH ON",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "RICH",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Primer",
          "response": "LOCKED IN",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Ignition switch",
          "response": "CHECK BOTH; TRY LEFT THEN RIGHT IF ENGINE DOES NOT RESPOND",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Throttle",
          "response": "TRY PARTIAL ADVANCE TO CHECK FOR PARTIAL POWER",
          "tickable": true
        },
        {
          "type": "action",
          "text": "If engine does not restart \u2014 proceed to forced landing",
          "response": "MAINTAIN BEST GLIDE; COMMIT TO FORCED LANDING PROCEDURE",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Mayday \u2014 declare on 121.5 or current frequency",
          "response": "MAYDAY DECLARED; SQUAWK 7700",
          "tickable": true
        }
      ]
    },
    {
      "id": "engine-fire-in-flight",
      "phase": "engine_fire_in_flight",
      "title": "Engine Fire in Flight",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-mem-1"
        },
        {
          "type": "action",
          "text": "Throttle",
          "response": "CLOSED",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-mem-2"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-mem-3"
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-in-flight-mem-4"
        },
        {
          "type": "action",
          "text": "Cabin heat and air vents",
          "response": "CLOSED \u2014 prevent fire gases from entering cockpit",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Airspeed",
          "response": "INCREASE TO AID AIRFLOW SUPPRESSION OF FIRE \u2014 DO NOT EXCEED STRUCTURAL LIMITS",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Forced landing",
          "response": "EXECUTE IMMEDIATELY \u2014 SEE FORCED LANDING SECTION",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Mayday",
          "response": "DECLARE ON 121.5 OR CURRENT FREQUENCY; SQUAWK 7700",
          "tickable": true
        }
      ]
    },
    {
      "id": "engine-fire-ground",
      "phase": "engine_fire_ground",
      "title": "Engine Fire on Ground",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Throttle \u2014 if induction fire, attempt to draw flame back into intake by cranking",
          "response": "CLOSED; ENGAGE STARTER TO CRANK IF INDUCTION FIRE",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-mem-1"
        },
        {
          "type": "action",
          "text": "Mixture",
          "response": "IDLE CUT-OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-mem-2"
        },
        {
          "type": "action",
          "text": "Fuel selector",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-mem-3"
        },
        {
          "type": "action",
          "text": "Ignition switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-mem-4"
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-mem-5"
        },
        {
          "type": "action",
          "text": "Evacuate aircraft \u2014 all occupants",
          "response": "EXIT IMMEDIATELY AND MOVE WELL CLEAR, UPWIND",
          "tickable": true,
          "memory_item": true,
          "id": "engine-fire-ground-mem-6"
        },
        {
          "type": "action",
          "text": "Fire extinguisher and emergency services",
          "response": "USE EXTINGUISHER IF SAFE TO APPROACH; CALL EMERGENCY SERVICES",
          "tickable": true
        }
      ]
    },
    {
      "id": "electrical-fire",
      "phase": "electrical_fire",
      "title": "Electrical Fire / Smoke in Cockpit",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF \u2014 remove electrical power source",
          "tickable": true,
          "memory_item": true,
          "id": "electrical-fire-mem-1"
        },
        {
          "type": "action",
          "text": "All electrical switches",
          "response": "OFF \u2014 individually, to isolate the fault before restoring power",
          "tickable": true,
          "memory_item": true,
          "id": "electrical-fire-mem-2"
        },
        {
          "type": "action",
          "text": "Cabin vents",
          "response": "OPEN \u2014 ventilate cockpit smoke",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Fire extinguisher",
          "response": "USE IF FIRE IS VISIBLE AND CAN BE REACHED SAFELY WITHOUT LOSING AIRCRAFT CONTROL",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Master switch \u2014 restore only if essential for continued safe flight",
          "response": "ON CAUTIOUSLY; OFF IMMEDIATELY IF SMOKE RECURS",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Land as soon as practicable",
          "response": "DIVERT TO NEAREST SUITABLE AIRPORT; DECLARE EMERGENCY IF REQUIRED",
          "tickable": true
        }
      ]
    },
    {
      "id": "oil-system-malfunction",
      "phase": "oil_system_malfunction",
      "title": "Loss of Oil Pressure",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Oil pressure and temperature gauges",
          "response": "CONFIRM LOW OR ZERO PRESSURE; NOTE IF TEMPERATURE IS ALSO RISING",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Landing area",
          "response": "IDENTIFY NEAREST SUITABLE FIELD AND PLAN FOR PRECAUTIONARY OR FORCED LANDING",
          "tickable": true,
          "memory_item": true,
          "id": "oil-system-malfunction-mem-2"
        },
        {
          "type": "action",
          "text": "Power",
          "response": "REDUCE TO MINIMUM REQUIRED FOR CONTINUED FLIGHT \u2014 HIGH POWER WITH NO OIL PRESSURE RISKS RAPID SEIZURE",
          "tickable": true
        },
        {
          "type": "caution",
          "text": "If oil temperature is also rising, engine failure is imminent. Do not wait for the engine to seize \u2014 proceed directly to forced landing.",
          "tickable": false
        },
        {
          "type": "action",
          "text": "Mayday",
          "response": "DECLARE ON 121.5 OR CURRENT FREQUENCY; SQUAWK 7700",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Mixture and ignition \u2014 when landing is assured",
          "response": "MIXTURE IDLE CUT-OFF; IGNITION OFF",
          "tickable": true
        }
      ]
    },
    {
      "id": "carburetor-icing",
      "phase": "carburetor_icing",
      "title": "Carburetor Ice",
      "criticality": "abnormal",
      "items": [
        {
          "type": "note",
          "text": "Indications: unexplained RPM loss, rough running, or engine stoppage \u2014 particularly in moist air with temperatures between approximately 20\u00b0F and 70\u00b0F (-7\u00b0C to 21\u00b0C). The Lycoming O-235 in the 152 is considered especially susceptible to carburetor icing. Treat any unexplained power loss as carb ice until proven otherwise.",
          "tickable": false
        },
        {
          "type": "action",
          "text": "Carburetor heat",
          "response": "APPLY FULL HOT IMMEDIATELY AND HOLD",
          "tickable": true,
          "memory_item": true,
          "id": "carburetor-icing-mem-2"
        },
        {
          "type": "action",
          "text": "Throttle \u2014 if engine is rough, hold current setting",
          "response": "DO NOT REDUCE POWER FURTHER WHILE ICE IS PRESENT",
          "tickable": true
        },
        {
          "type": "challenge",
          "text": "Expect a further RPM drop as ice melts and passes through \u2014 this is normal. Continue holding FULL HOT.",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Recovery confirmed",
          "response": "RPM RETURNS AND STABILIZES ABOVE PRE-ICE LEVEL; ENGINE RUNNING SMOOTHLY",
          "tickable": true
        },
        {
          "type": "action",
          "text": "If engine does not recover \u2014 prepare for forced landing",
          "response": "ESTABLISH BEST GLIDE; EXECUTE FORCED LANDING PROCEDURE",
          "tickable": true
        },
        {
          "type": "action",
          "text": "After recovery \u2014 carburetor heat management",
          "response": "CONTINUE CARB HEAT AS CONDITIONS WARRANT; DO NOT RETURN TO COLD IF ICING CONDITIONS PERSIST",
          "tickable": true
        }
      ]
    },
    {
      "id": "forced-landing",
      "phase": "forced_landing",
      "title": "Forced Landing (Power-Off)",
      "criticality": "emergency",
      "items": [
        {
          "type": "action",
          "text": "Airspeed",
          "response": "BEST GLIDE PER POH \u2014 ESTABLISHED AND HELD THROUGHOUT",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-mem-1"
        },
        {
          "type": "action",
          "text": "Field selection",
          "response": "CHOOSE OPEN, LEVEL SURFACE INTO WIND WHERE POSSIBLE; AVOID OBSTACLES AND POPULATED AREAS",
          "tickable": true,
          "memory_item": true,
          "id": "forced-landing-mem-2"
        },
        {
          "type": "action",
          "text": "Mayday call \u2014 121.5 MHz or current frequency",
          "response": "MAYDAY DECLARED: AIRCRAFT TYPE, POSITION, ALTITUDE, INTENTIONS",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Transponder",
          "response": "7700",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Fuel selector \u2014 when field is assured",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Mixture \u2014 when field is assured",
          "response": "IDLE CUT-OFF",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Ignition switch",
          "response": "OFF",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Master switch",
          "response": "OFF BEFORE TOUCHDOWN",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Flaps \u2014 deploy when field is positively within reach",
          "response": "EXTENDED AS REQUIRED FOR APPROACH ANGLE",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Seat belts and harnesses \u2014 all occupants",
          "response": "CONFIRM TIGHT",
          "tickable": true
        },
        {
          "type": "action",
          "text": "Doors \u2014 unlatch before touchdown",
          "response": "UNLATCHED TO PREVENT JAMMING ON IMPACT",
          "tickable": true
        },
        {
          "type": "challenge",
          "text": "Touch down at minimum controllable airspeed; use all available terrain to roll out and stop",
          "tickable": true
        }
      ]
    }
  ]
}